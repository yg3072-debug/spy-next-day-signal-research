# Smoke-test artefacts are a plumbing check, not a deliverable.
results/smoke/

# Per-document alternative-data text. Third-party content; redistributing it is the
# publisher's decision, not this project's -- the same reasoning applied to the
# Loughran-McDonald dictionary. The session-level aggregates the study consumes ARE
# committed, along with the source checksums, so the derivation stays verifiable.
data/alt/truth_social_sessions.csv
data/alt/news_headlines_sessions.csv

# Third-party inputs, not redistributed. scripts/fetch_lexicon.py retrieves the
# dictionary and verifies its checksum; docs/scraping_notes.md names both text
# sources. Override the locations with LM_DICTIONARY and ALT_DATA_SOURCE.
vendor/
data/raw/

# Raw third-party corpora and any per-record text. Never committed: whether to
# redistribute third-party content is the publisher's decision, not this project's.
# The session-level aggregates the study consumes ARE committed.
